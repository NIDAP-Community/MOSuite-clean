	"parameters": [
		{
			"id": "vErI4n2A3SVqtFPz",
			"category": "gDLmTU36PrmD13RK",
			"name": "multiOmicDataSet file pattern",
			"param_name": "regex_moo",
			"description": "Regular expression pattern to match a multiOmicDataset RDS file in data/",
			"type": "text",
			"value_type": "string",
			"default_value": ".*\\.rds$"
		},
		{
			"id": "vJvArGM6rjelGp9u",
			"category": "gn9FXwemlVazWQIo",
			"name": "Clean up column names",
			"param_name": "cleanup_column_names",
			"type": "text",
			"value_type": "string",
			"default_value": "TRUE",
			"pattern": "TRUE|FALSE|T|F"
		},
		{
			"id": "UA4GuIpVAxdcmHAG",
			"category": "XqgPq28Eo5VCFSZu",
			"name": "count type",
			"param_name": "count_type",
			"description": "which counts to clean. Must be a count type in names(moo@counts)",
			"type": "text",
			"value_type": "string",
			"default_value": "raw"
		},
		{
			"id": "vJvArGM6rjelGp9u",
			"category": "gn9FXwemlVazWQIo",
			"name": "Sample ID column name",
			"param_name": "sample_id_colname",
			"description": "Column name for sample IDs (leave blank for auto-detection)",
			"type": "text",
			"value_type": "string",
			"default_value": ""
		},
		{
			"id": "vJvArGM6rjelGp9w",
			"category": "gn9FXwemlVazWQIo",
			"name": "Feature ID column name",
			"param_name": "feature_id_colname",
			"description": "Column name for feature IDs (leave blank for auto-detection)",
			"type": "text",
			"value_type": "string",
			"default_value": ""
		},
		{
			"id": "vJvArGM6rjelGp9x",
			"category": "gn9FXwemlVazWQIo",
			"name": "Split gene names",
			"param_name": "split_gene_name",
			"description": "Split gene name column by special characters (|,-,:_)",
			"type": "text",
			"value_type": "string",
			"default_value": "TRUE",
			"pattern": "TRUE|FALSE|T|F"
		},
		{
			"id": "vJvArGM6rjelGp9y",
			"category": "XqgPq28Eo5VCFSZu",
			"name": "Samples to rename",
			"param_name": "samples_to_rename",
			"description": "Sample names to rename (advanced)",
			"type": "text",
			"value_type": "string",
			"default_value": ""
		},
		{
			"id": "vJvArGM6rjelGp9z",
			"category": "XqgPq28Eo5VCFSZu",
			"name": "Aggregate duplicate gene names",
			"param_name": "aggregate_rows_with_duplicate_gene_names",
			"description": "Sum counts across duplicate feature ID rows",
			"type": "text",
			"value_type": "string",
			"default_value": "TRUE",
			"pattern": "TRUE|FALSE|T|F"
		},
		{
			"id": "vJvArGM6rjelGp9a",
			"category": "XqgPq28Eo5VCFSZu",
			"name": "Column for collapsing duplicates",
			"param_name": "gene_name_column_to_use_for_collapsing_duplicates",
			"description": "Which column to use for grouping duplicate rows",
			"type": "text",
			"value_type": "string",
			"default_value": ""
		}
